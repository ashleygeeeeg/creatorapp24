# MongoDB Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=creatorapp24

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2025
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# AI Service (Emergent LLM)
EMERGENT_LLM_KEY=your-emergent-llm-api-key-here

# Frontend URL (Vercel or other hosting)
PUBLIC_WEB_URL=https://your-app.vercel.app

# API URL (this service)
PUBLIC_API_URL=https://your-api.example.com
BACKEND_PUBLIC_URL=https://your-api.example.com

# AppCreator24 Android WebView Shell
APPCREATOR24_APP_URL=https://www.appcreator24.com/appXXXXXXXX

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
